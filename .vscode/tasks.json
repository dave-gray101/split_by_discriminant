            "type": "shell",
            "command": "cargo test --features indexmap",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "showReuseMessage": false
            },
            "problemMatcher": []
